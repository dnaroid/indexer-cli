# idx ask global configuration. Remove the leading # only for settings you use.
# Never commit or share real API keys; keep this file private (mode 0600).

# Direct OpenAI-compatible Responses API (default)
# IDX_ASK_BACKEND=openai
# OPENAI_API_KEY=replace-with-your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# IDX_ASK_MODEL=gpt-6-luna
# Retry inference failures (0–5; default 2). Tool execution is never retried.
# IDX_ASK_RETRIES=2

# Individual primary model limits. Pi uses its catalog limits unless capped here.
# Unknown OpenAI-compatible models default to 16000 context / 2000 output tokens.
# IDX_ASK_CONTEXT_TOKENS=16000
# IDX_ASK_MAX_OUTPUT_TOKENS=2000

# Optional explicit fallback, activated only when a model is selected.
# Defaults to the primary backend; Pi fallback needs a provider (or inherits
# IDX_PI_PROVIDER when the primary backend is also Pi).
# IDX_ASK_FALLBACK_BACKEND=openai
# IDX_ASK_FALLBACK_MODEL=replace-with-an-available-model-id
# IDX_ASK_FALLBACK_PROVIDER=provider-name
# IDX_ASK_FALLBACK_API_KEY=replace-with-your-api-key
# IDX_ASK_FALLBACK_BASE_URL=https://api.openai.com/v1
# Fallback limits are independent, not inherited from the primary model.
# IDX_ASK_FALLBACK_CONTEXT_TOKENS=16000
# IDX_ASK_FALLBACK_MAX_OUTPUT_TOKENS=2000

# Or use Pi and its saved authentication (requires an installed Pi runtime)
# IDX_ASK_BACKEND=pi
# IDX_PI_PROVIDER=openai-codex
# IDX_PI_MODEL=replace-with-an-available-model-id
# PI_CODING_AGENT_DIR=/absolute/path/to/custom/pi-agent-directory
