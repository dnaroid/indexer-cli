# idx global OpenRouter/classifier configuration. Remove the leading # only for settings you use.
# Never commit or share real API keys; keep this file private (mode 0600).

# Used by `idx init --embedding openrouter` and by optional advisory document classification.
# OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Advisory document classification during indexing via OpenRouter Jev Decisions API.
# IDX_JEV_MODEL=~typesafe/jev-latest
# IDX_JEV_URL=https://openrouter.ai/api/alpha/decisions
# IDX_JEV_TIMEOUT_MS=5000
# IDX_JEV_KIND_MIN_CONFIDENCE=0.90
# IDX_JEV_STATUS_MIN_CONFIDENCE=0.65
